@model Sistema_Gestion_Biblioteca_Escolar.ViewModels.LibroViewModel
@{ ViewBag.Title = "Eliminar libro"; }

<h2>Eliminar libro</h2>
<h5 class="text-danger">¿Seguro que desea eliminar este libro?</h5>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Autor</dd>
    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>
    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.Categoria</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Eliminar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}