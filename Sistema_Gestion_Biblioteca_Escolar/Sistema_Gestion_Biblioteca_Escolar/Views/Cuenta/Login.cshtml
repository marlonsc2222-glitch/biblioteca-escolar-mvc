@model Sistema_Gestion_Biblioteca_Escolar.ViewModels.LoginPersonalViewModel

@{
    ViewBag.Title = "Acceso del personal";
}

<h2>Acceso del personal</h2>

@* Formulario sugerido por ChatGPT y adaptado al ViewModel del proyecto. *@
@using (Html.BeginForm("Login", "Cuenta", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.NombreUsuario)
        @Html.TextBoxFor(m => m.NombreUsuario,
                 new { @class = "form-control", autocomplete = "username" })
        @Html.ValidationMessageFor(m => m.NombreUsuario, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Contrasena)
        @Html.PasswordFor(m => m.Contrasena,
                 new { @class = "form-control", autocomplete = "current-password" })
        @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Ingresar</button>
}