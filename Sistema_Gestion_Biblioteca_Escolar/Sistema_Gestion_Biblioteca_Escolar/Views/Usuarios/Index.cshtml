@model IEnumerable<Sistema_Gestion_Biblioteca_Escolar.ViewModels.UsuarioViewModel>
@{ ViewBag.Title = "Usuarios"; }

<h2>Usuarios</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>@Html.ActionLink("Registrar usuario", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Correo</th>
            <th>Tipo de usuario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nombre</td>
                <td>@u.Cedula</td>
                <td>@u.Correo</td>
                <td>@u.TipoUsuario</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = u.UsuarioId }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = u.UsuarioId }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>