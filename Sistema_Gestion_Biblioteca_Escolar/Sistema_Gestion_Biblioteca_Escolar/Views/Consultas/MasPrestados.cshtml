@model IEnumerable<Sistema_Gestion_Biblioteca_Escolar.Models.LibroRanking>
@{
    ViewBag.Title = "Libros más prestados";
    int posicion = 1; // Número de posición en el ranking
}

<h2>Libros más prestados (Top Ranking)</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Veces prestado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@(posicion++)</td>
                <td><strong>@l.Titulo</strong></td>
                <td>@l.Autor</td>
                <td><span class="badge bg-success">@l.VecesPrestado veces</span></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay préstamos registrados.</p>
}